{
  "name": "RadarItem",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "edgar",
        "tdnet",
        "press"
      ]
    },
    "source_tier": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "generated"
      ],
      "default": "primary",
      "description": "\u60c5\u5831\u306e\u6b63\u7d71\u6027: primary=\u4e00\u6b21\u60c5\u5831(EDGAR/TDnet), secondary=\u4e8c\u6b21(\u30d7\u30ec\u30b9), generated=AI\u751f\u6210"
    },
    "region": {
      "type": "string",
      "enum": [
        "us",
        "jp",
        "global"
      ],
      "default": "us"
    },
    "ticker": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "form_type": {
      "type": "string"
    },
    "headline": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "beginner_note": {
      "type": "string",
      "description": "\u521d\u5fc3\u8005\u5411\u3051\u3072\u3068\u3053\u3068\u89e3\u8aac\uff08\u6559\u80b2\u30d5\u30c3\u30af\uff09"
    },
    "pro_points": {
      "type": "string",
      "description": "\u30d7\u30ed\u5411\u3051\u8981\u70b9\uff08JSON\u914d\u5217\uff09"
    },
    "impact_sectors": {
      "type": "string",
      "description": "\u6ce2\u53ca\u30bb\u30af\u30bf\u30fc\uff08JSON\u914d\u5217\uff09"
    },
    "impact_related": {
      "type": "string",
      "description": "\u95a2\u9023\u9298\u67c4\u30fb\u4f01\u696d\uff08JSON\u914d\u5217\uff09"
    },
    "source_url": {
      "type": "string"
    },
    "published_at": {
      "type": "string"
    },
    "sector": {
      "type": "string"
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "bullish",
        "neutral",
        "bearish"
      ],
      "default": "neutral"
    },
    "language": {
      "type": "string",
      "default": "jp"
    }
  },
  "required": [
    "headline",
    "region",
    "source"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}