{
  "name": "RadarItem",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "edgar",
        "tdnet",
        "press"
      ]
    },
    "source_tier": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "generated"
      ],
      "default": "primary",
      "description": "\u60c5\u5831\u306e\u6b63\u7d71\u6027: primary=\u4e00\u6b21\u60c5\u5831(EDGAR/TDnet), secondary=\u4e8c\u6b21(\u30d7\u30ec\u30b9), generated=AI\u751f\u6210"
    },
    "region": {
      "type": "string",
      "enum": [
        "us",
        "jp",
        "global"
      ],
      "default": "us"
    },
    "ticker": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "form_type": {
      "type": "string"
    },
    "headline": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "published_at": {
      "type": "string"
    },
    "sector": {
      "type": "string"
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "bullish",
        "neutral",
        "bearish"
      ],
      "default": "neutral"
    },
    "language": {
      "type": "string",
      "default": "jp"
    }
  },
  "required": [
    "headline",
    "region",
    "source"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}