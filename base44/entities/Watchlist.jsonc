{
  "name": "Watchlist",
  "type": "object",
  "properties": {
    "ticker": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "target_price": {
      "type": "number"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "ticker"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}